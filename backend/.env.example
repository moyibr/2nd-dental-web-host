# Copy to backend/.env and fill in real values. Never commit the real .env file
# (it's already covered by the root .gitignore's `.env*` pattern).

# Port this API listens on.
PORT=4000

# Must exactly match the origin the frontend is served from (protocol + host + port).
# Requests from any other origin are rejected by CORS. Comma-separate multiple origins
# if you serve staging + production from the same backend.
CORS_ORIGIN=http://localhost:5173

# SMTP credentials used to email the clinic when a new appointment request comes in.
# Leave these blank during local development — the server falls back to a safe
# console notice (no patient data logged) instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Website Booking <no-reply@example.com>"

# Where appointment request notifications are sent. Defaults to config.contact.email
# (from ../config/clinic.config.json) if unset.
NOTIFY_EMAIL=

# Rate limiting for POST /api/appointments.
RATE_LIMIT_WINDOW_MINUTES=10
RATE_LIMIT_MAX_REQUESTS=5
