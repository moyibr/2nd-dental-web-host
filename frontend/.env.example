# Copy to .env (gitignored) for local development.
# This is the ONLY frontend env var — it's a URL, not a secret, and Vite only
# ever exposes variables prefixed with VITE_ to the browser bundle. No API
# keys or credentials belong here or anywhere in the frontend.

# Base URL of the appointments API (see /backend). No trailing slash.
VITE_API_URL=http://localhost:4000/api
